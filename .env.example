# =====================================================================
# BUGO DUFT — environment contract (NAMES ONLY — never commit real secrets)
# Server-only vars must NOT be prefixed NEXT_PUBLIC_. Service-role key never
# reaches the browser. Missing integration vars => honest "not configured" UI.
# =====================================================================

# ---- App ----
NEXT_PUBLIC_SITE_URL=https://bugoduft.de
NEXT_PUBLIC_DEFAULT_LOCALE=de
APP_ENV=development           # development | staging | production
ADMIN_NOTIFICATION_EMAIL=bugoduft@gmail.com

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # SERVER ONLY. Bypasses RLS. Never expose.
SUPABASE_STORAGE_BUCKET_PRIVATE=customer-files

# ---- Shopify (Storefront cart/checkout) — SERVER ONLY ----
SHOPIFY_STORE_DOMAIN=            # e.g. bugoduft.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Base product variant GIDs (gid://shopify/ProductVariant/...):
SHOPIFY_VARIANT_STANDARD=
SHOPIFY_VARIANT_PREMIUM=
SHOPIFY_VARIANT_DELUXE=
SHOPIFY_VARIANT_VIP=
# One-time Intensivduft +30,00 € surcharge variant (leave blank until created):
SHOPIFY_VARIANT_INTENSE_SURCHARGE=
# ---- Shopify Admin API (installed app, client-credentials) — SERVER ONLY ----
SHOPIFY_CLIENT_ID=              # Dev Dashboard app Client ID
SHOPIFY_CLIENT_SECRET=          # Dev Dashboard app Client Secret (also used for webhook HMAC)
# Optional explicit webhook secret; falls back to SHOPIFY_CLIENT_SECRET if unset:
SHOPIFY_WEBHOOK_SECRET=



# ---- Payment (Shopier target) — leave blank until official docs/creds ----
# Do NOT invent endpoints; provider stays "Yapılandırılmadı" while blank.
PAYMENT_PROVIDER=              # shopier | ...
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- Transactional email ----
EMAIL_PROVIDER=               # resend | postmark | ses | ...
EMAIL_API_KEY=
EMAIL_FROM=

# ---- Invoice / e-fatura ----
INVOICE_PROVIDER=
INVOICE_API_KEY=

# ---- Translation (LLM) — DE→EN/FR drafts (human approval before publish) ----
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=

# ---- Analytics / marketing (consent-gated) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Security ----
APPROVAL_TOKEN_SECRET=        # signing secret for design-approval tokens
RATE_LIMIT_REDIS_URL=         # optional
